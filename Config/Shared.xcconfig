// Shared defaults for all configurations. Personal overrides stay in Local.xcconfig.
FOCUSSIGNAL_BUNDLE_PREFIX = edu.gatech.focussignal
FOCUSSIGNAL_APP_GROUP = group.edu.gatech.focussignal
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY[sdk=iphonesimulator*] = -

IPHONEOS_DEPLOYMENT_TARGET = 17.4
SWIFT_VERSION = 5.0
SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1,2
SUPPORTS_MACCATALYST = NO
SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD = NO
SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD = NO

MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_LANGUAGE = en
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Quoted includes resolve relative to this file. Missing personal config is fine.
#include? "Local.xcconfig"
